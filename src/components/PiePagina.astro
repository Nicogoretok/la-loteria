---
interface Props {
  autor: string;
}

const { autor } = Astro.props;
---

<footer class="pie-pagina">
  <p>Sitio de interpretación literaria sobre la obra de {autor}.</p>
  <nav class="navegacion-pie">
    <a href="/">Inicio</a>
    <a href="/obra">La obra</a>
    <a href="/interpretaciones">Interpretaciones</a>
  </nav>
</footer>

<style>
  .pie-pagina {
    background-color: var(--color-negro-carbon);
    color: var(--color-crema);
    text-align: center;
    padding: 2rem 1.5rem;
    margin-top: var(--espaciado-lg);
  }

  .pie-pagina p {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
  }

  .navegacion-pie {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .navegacion-pie a {
    color: var(--color-amarillo-trigo);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .navegacion-pie a:hover {
    text-decoration: underline;
  }
</style>
