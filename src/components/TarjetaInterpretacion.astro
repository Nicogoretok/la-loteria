---
interface Props {
  criterio: string;
  interpretacion: string;
  evidencia: string;
  argumentacion: string;
}

const { criterio, interpretacion, evidencia, argumentacion } = Astro.props;
---

<article class="tarjeta-interpretacion">
  <h3 class="criterio-tarjeta">{criterio}</h3>

  <section class="bloque-tarjeta">
    <h4>Interpretación</h4>
    <p>{interpretacion}</p>
  </section>

  <section class="bloque-tarjeta">
    <h4>Evidencia</h4>
    <blockquote>{evidencia}</blockquote>
  </section>

  <section class="bloque-tarjeta">
    <h4>Argumentación</h4>
    <p>{argumentacion}</p>
  </section>
</article>

<style>
  .tarjeta-interpretacion {
    background-color: #ffffff;
    border: 1px solid var(--color-gris-piedra);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .tarjeta-interpretacion:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(43, 40, 37, 0.15);
  }

  .criterio-tarjeta {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-rojo-apagado);
  }

  .bloque-tarjeta h4 {
    margin: 0 0 0.25rem;
    font-family: var(--fuente-parrafos);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-gris-piedra);
  }

  .bloque-tarjeta p {
    margin: 0;
    font-size: 0.95rem;
  }
</style>
