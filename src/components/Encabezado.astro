---
interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<header class="encabezado">
  <div class="franja-superior"></div>
  <div class="contenedor-encabezado">
    <h1 class="titulo-sitio">{titulo}</h1>
    <nav class="navegacion">
      <a href="/">Inicio</a>
      <a href="/obra">La obra</a>
      <a href="/interpretaciones">Interpretaciones</a>
    </nav>
  </div>
</header>

<style>
  .franja-superior {
    height: 6px;
    background-color: var(--color-rojo-apagado);
  }

  .encabezado {
    background-color: var(--color-crema);
    text-align: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(107, 104, 98, 0.25);
  }

  .contenedor-encabezado {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .titulo-sitio {
    margin: 0 0 1rem;
  }

  .navegacion {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .navegacion a {
    text-decoration: none;
    font-weight: 500;
    color: var(--color-negro-carbon);
    padding: 0.4rem 1rem;
    border-radius: 999px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .navegacion a:hover {
    background-color: var(--color-rojo-apagado);
    color: var(--color-crema);
  }
</style>
